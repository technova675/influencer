# ---------------------------------------------------------------------------
# Supabase  -  https://supabase.com/dashboard  ->  your project
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=



# ---------------------------------------------------------------------------
# Admin dashboard access (the agency-side roster + filters)
# ---------------------------------------------------------------------------

# Password for the internal roster dashboard. Pick any long random string.
ADMIN_PASSWORD=
# Used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# ---------------------------------------------------------------------------
# Cloudflare R2  -  holds creator profile photos and showcase video/images
# Dashboard -> R2 -> your bucket, and R2 -> Manage API Tokens
# ---------------------------------------------------------------------------

# R2 -> Overview, shown as "Account ID" in the right-hand panel.
R2_ACCOUNT_ID=

# R2 -> Manage API Tokens -> Create token (Object Read & Write on this bucket).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket name exactly as it appears in the R2 dashboard.
R2_BUCKET=creator-media

# Public base URL that serves objects, NO trailing slash. Either the bucket's
# r2.dev subdomain (Settings -> Public Development URL) or, better, a custom
# domain you connect to the bucket.
#   https://pub-xxxxxxxxxxxx.r2.dev
#   https://media.yourdomain.com
NEXT_PUBLIC_R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Optional - fill in later, nothing breaks if these stay empty
# ---------------------------------------------------------------------------


# Email notification when a new creator submits (Resend, resend.com).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# Public base URL of the site. Local dev runs on port 3200.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
